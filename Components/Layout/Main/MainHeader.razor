@page "/MainHeader"
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager

<header class="p-4 bg-surface flex justify-between items-center">
    <div class="flex items-end gap-4 min-w-96 w-96">
        <a href="/">
            <img src="images/logo.png" alt="Logo" class="w-40 sm:w-52 h-auto"/>
        </a>
        <p class="font-bold text-2xl pb-0.5 text-surface capitalize">
            @_currentUrl.Split('/').First()
        </p>
    </div>

    @if (_currentUrl.Length == 0)
    {
        <ul>
            <li><a href="/calendar" class="font-bold hover:text-hover transition-colors">Calendar</a></li>
        </ul>
    }
    else
    {
        <ul class="flex gap-4">
            @foreach (var item in Routes.NavItems)
            {
                if (_currentUrl.Split("/").Last().Contains(item.Value.Split('/').Last()))
                {
                    <li>
                        <a class="font-bold text-secondary transition-colors">@item.Key</a>
                    </li>
                }
                else
                {
                    <li>
                        <a href="@item.Value" class="font-bold hover:text-hover transition-colors">@item.Key</a>
                    </li>
                }

            }
        </ul>
    }
    <div class="flex justify-end w-96">
        <div>
            <AuthorizeView>
                <Authorized>
                    <a href="/logout" class="text-heading w-96 hover:text-hover transition-colors text-end">Logout</a>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

</header>
@code {
    private string _currentUrl = string.Empty;

    protected override void OnInitialized()
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
    }
}